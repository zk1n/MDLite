# Build and dependency working directories
/build/
/out/
/dist/
/.cache/
# Existing ignored local build material remains private.
/.vs/
*.pdb
*.ilk

# Machine-local agent configuration and transient execution records
/.codex/
/.codex-shared/
/.local/
/AGENTS.override.md

# User data / generated state; declarative .mdlite settings remain trackable
**/.mdlite/.cache/
**/.mdlite/.state/

# Secrets (public sample configuration uses .example files)
.env
.env.*
!.env.example
*.pfx
*.p12
*.key
*.pem
*.dmp

# Rust build artifacts and private task inputs
/target/
/.codex-runtime/
/samples/

# Machine-local semantic code-search configuration and indexes
/.grepai/
