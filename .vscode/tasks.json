{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MDLite: Rust Debug build",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/tools/Invoke-RustBuild.ps1", "-Configuration", "Debug", "-PrepareDemo"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "MDLite: Rust Release build",
      "type": "shell",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/tools/Invoke-RustBuild.ps1", "-Configuration", "Release", "-PrepareDemo"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"]
    }
  ]
}
